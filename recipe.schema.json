{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/floffah/culprit/internal/recipe/recipe",
 "$ref": "#/$defs/Recipe",
 "$defs": {
  "Input": {
   "properties": {
    "id": {
     "type": "string",
     "description": "Stable identifier used to reference this input from targets."
    },
    "kind": {
     "type": "string",
     "enum": [
      "path"
     ],
     "description": "The kind of input."
    },
    "prompt": {
     "type": "string",
     "description": "Prompt shown when collecting this input."
    },
    "description": {
     "type": "string",
     "description": "Additional help text shown below the prompt."
    },
    "default": {
     "type": "string",
     "description": "Default value used for this input."
    },
    "placeholder": {
     "type": "string",
     "description": "Placeholder shown when the input is empty."
    }
   },
   "additionalProperties": false,
   "type": "object",
   "required": [
    "id",
    "kind",
    "prompt",
    "description",
    "default",
    "placeholder"
   ]
  },
  "Recipe": {
   "properties": {
    "name": {
     "type": "string",
     "description": "The name of the recipe, must be unique across all recipes."
    },
    "description": {
     "type": "string",
     "description": "A brief description of the recipe."
    },
    "type": {
     "type": "string",
     "enum": [
      "soft",
      "hard",
      "culprit"
     ],
     "description": "The type of the recipe."
    },
    "inputs": {
     "items": {
      "$ref": "#/$defs/Input"
     },
     "type": "array",
     "description": "Inputs required by the recipe."
    },
    "targets": {
     "items": {
      "$ref": "#/$defs/Target"
     },
     "type": "array",
     "description": "The targets of the recipe."
    }
   },
   "additionalProperties": false,
   "type": "object",
   "required": [
    "name",
    "description",
    "type",
    "inputs",
    "targets"
   ]
  },
  "Target": {
   "properties": {
    "reason": {
     "type": "string",
     "description": "The reason why this target should be cleaned up."
    },
    "kind": {
     "type": "string",
     "enum": [
      "absolute",
      "command"
     ],
     "description": "The kind of the target."
    },
    "path": {
     "type": "string",
     "description": "Absolute path to the file to be cleaned up"
    },
    "command": {
     "type": "string",
     "description": "The command to be executed to clean up the target. Only allowed with \"command\" kind."
    },
    "related_paths": {
     "items": {
      "type": "string"
     },
     "type": "array",
     "description": "List of related paths to be used to calculate clearable size. Only allowed with \"command\" kind."
    }
   },
   "additionalProperties": false,
   "type": "object",
   "required": [
    "reason",
    "kind",
    "path",
    "command",
    "related_paths"
   ]
  }
 }
}